{
  "name": "FLODesign",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/vendor.mjs",
    "dev": "npx serve www",
    "server": "node server/index.mjs",
    "dev:full": "concurrently -k \"npm:dev\" \"npm:server\"",
    "check": "node --check server/index.mjs && node --check server/middleware/cors.mjs && node --check server/data/store.mjs && node --check server/routes/fabrics.mjs && node --check server/routes/quotes.mjs && node --check www/app.js && node --check www/config.js && node --check www/boot.js",
    "sync": "npm run setup && cap sync",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.1.0",
    "@fontsource/archivo": "^5.0.0",
    "@fontsource/fraunces": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "concurrently": "^10.0.5",
    "serve": "^14.2.0"
  }
}
